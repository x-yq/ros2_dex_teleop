FROM osrf/ros:humble-desktop-full

# Set working directory
WORKDIR /root/

# Suppress specific Python warnings
ENV PYTHONWARNINGS="ignore:easy_install command is deprecated,ignore:setup.py install is deprecated"

# Define directory-related environment variables
ENV SRC="/src" \
    WS="/root/dev_ws/" \
    WS_SRC="/root/dev_ws/src" \
    ROS_LOG_DIR="/src/log/"

# Accept build-time arguments
ARG DEV
ENV DEV=${DEV}

# Install essential tools and dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    git \
    python3-pip \
    python3-psutil \
    docker.io \
    ros-humble-ros-gz \
    ros-humble-moveit \
    ros-humble-gazebo-ros \
    ros-humble-gazebo-ros-pkgs \
    ros-humble-filters \
    ros-humble-gazebo-ros2-control \
    ros-humble-ros2-control \
    ros-humble-control-toolbox \
    ros-humble-joint-state-broadcaster \
    ros-humble-joint-trajectory-controller \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir \
    docker 


# Initialize rosdep safely (ignore if already done)
RUN rosdep init 2>/dev/null || true && rosdep update

# === Set up ROS 2 workspace ===
RUN echo "Creating ROS workspace..." && \
    rm -rf ${WS} && mkdir -p ${WS_SRC}

# # === Clone xarm_ros2 ===
# RUN cd ${WS_SRC} && \
#     git clone https://github.com/xArm-Developer/xarm_ros2.git --recursive -b humble && \
#     cd xarm_ros2 && \
#     git pull && git submodule sync && git submodule update --init --remote

# COPY crisp_controllers ${WS_SRC}/crisp_controllers
COPY xarm_ros2 ${WS_SRC}/xarm_ros2
COPY kpi_monitor ${WS_SRC}/kpi_monitor
COPY core_bases ${WS_SRC}/core_bases
COPY component_interfaces ${WS_SRC}/component_interfaces
COPY system_interfaces ${WS_SRC}/system_interfaces
COPY config_files ${WS_SRC}/config_files
COPY teleop_launcher ${WS_SRC}/teleop_launcher


RUN cd ${WS_SRC} && git clone -b ros2 https://github.com/fzi-forschungszentrum-informatik/cartesian_controllers.git

# === Install dependencies ===
RUN apt-get update && \
    rosdep install --from-paths ${WS_SRC} --ignore-src -y --rosdistro humble && \
    rm -rf /var/lib/apt/lists/*

# === Build the workspace ===
SHELL ["/bin/bash", "-c"]
RUN if [ -d "/opt/ros/humble/install" ]; then \
        source /opt/ros/humble/install/setup.bash; \
    else \
        source /opt/ros/humble/setup.bash; \
    fi && \
    echo "source /opt/ros/humble/setup.bash" >> ~/.bashrc && \
    cd ${WS} && \
    colcon build --packages-skip cartesian_controller_simulation cartesian_controller_tests && \
    echo "source ${WS}install/setup.bash" >> ~/.bashrc

# === Final stage: set up runtime ===
WORKDIR ${SRC}
COPY simulated_env_launcher.py ${SRC}/

CMD ["/bin/bash", "-c", "source /opt/ros/humble/setup.bash && source /root/dev_ws/install/setup.bash"]
